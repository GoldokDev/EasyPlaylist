# The production-safe Compose publishes only the web frontend on loopback.
WEB_PORT=5173

# These ports are published on loopback only when compose.local.yaml or the
# isolated PostgreSQL test override is explicitly selected.
API_PORT=3000
DB_PORT=5432

# Local PostgreSQL only. compose.production.yaml requires an explicit password.
POSTGRES_DB=easyplaylist
POSTGRES_USER=easyplaylist
POSTGRES_PASSWORD=local-development-only

# Used when the API runs outside Docker Compose.
DATABASE_URL=postgresql://easyplaylist:local-development-only@127.0.0.1:5432/easyplaylist

# Local-only cryptographic material. compose.production.yaml forces secure cookies
# and requires explicit signing and encryption keys.
COOKIE_SECURE=false
GUEST_COOKIE_SIGNING_KEY=local-development-signing-key-change-me
SECRETS_ACTIVE_KEY_VERSION=1
# Base64 for exactly 32 bytes. This documented value is only a local placeholder.
SECRETS_ENCRYPTION_KEY_V1=bG9jYWwtZGV2ZWxvcG1lbnQtZW5jcnlwdGlvbi1rZXk=

# Lobby lifecycle. Defaults preserve the accepted 24-hour ephemeral policy.
LOBBY_TTL_HOURS=24
LOBBY_EXPIRATION_SWEEP_INTERVAL_MS=60000
LOBBY_EXPIRATION_BATCH_SIZE=100

# YouTube Data API v3. Keep this server-side and restrict the key in Google Cloud.
# Without a key, EasyPlaylist keeps the deterministic demo catalog available.
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=FR
