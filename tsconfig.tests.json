{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "apps/**/*.test.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.failure.config.ts",
    "vitest.integration.config.ts"
  ]
}
